{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:minewater-passport:schema:0.1",
  "title": "MineWater Passport - site-level water report (draft v0.1)",
  "description": "Proposed minimum site-level water reporting standard for mining and mineral-processing sites. Volumes in megalitres (ML; 1 ML = 1,000 m3). Built on the ICMM Water Reporting Good Practice Guide (2nd ed., 2021) and the Minerals Council of Australia Water Accounting Framework (WAF) v2.0. 'x-mwp' annotations carry the tier and the crosswalk to GRI 303/GRI 14, ESRS E3, CDP (2024+ questionnaire, module 9) and IRMA Standard v1.0 chapter 4.2. Draft by a hackathon team - not an endorsed standard.",
  "type": "object",
  "required": ["passport_version", "tier", "site", "period", "production", "water", "assurance"],
  "x-mwp": { "tier1_fields": ["site.site_id", "site.name", "site.latitude", "site.longitude", "site.primary_commodity", "site.mine_type", "site.processing_route", "period.year", "production.ore_processed_t", "production.products[].metal_content_t", "water.withdrawals[]", "water.discharges[]", "water.consumption.total_ml", "water.reuse.reused_recycled_ml", "assurance.level"] },
  "properties": {
    "passport_version": { "const": "0.1", "title": "Passport schema version" },
    "synthetic": { "type": "boolean", "title": "Synthetic / illustrative record", "description": "True for demo data. Must be displayed to users." },
    "tier": {
      "title": "Reporting tier",
      "enum": ["tier1", "tier2"],
      "description": "tier1 = 12 must-report data points; tier2 = full WAF-style site water balance.",
      "x-mwp": { "tier": 1 }
    },
    "site": {
      "type": "object",
      "title": "Site identity",
      "required": ["site_id", "name", "country", "latitude", "longitude", "primary_commodity", "mine_type", "processing_route"],
      "properties": {
        "site_id": { "type": "string", "title": "Site ID", "pattern": "^MWP-[A-Z]{2}-[0-9]{4}$", "description": "MWP-<ISO country>-<4 digits>. Stable across years.", "x-mwp": { "tier": 1, "tier1_no": 1, "cdp": "9.3.1 (facility reference)", "gri": "GRI 14.7 (report by mine site)" } },
        "name": { "type": "string", "title": "Site name", "minLength": 2, "x-mwp": { "tier": 1, "tier1_no": 1 } },
        "operator": { "type": "string", "title": "Operator / owner" },
        "country": { "type": "string", "title": "Country (ISO 3166-1 alpha-2)", "pattern": "^[A-Z]{2}$", "x-mwp": { "tier": 1, "tier1_no": 2 } },
        "latitude": { "type": "number", "title": "Latitude (WGS84)", "minimum": -90, "maximum": 90, "x-mwp": { "tier": 1, "tier1_no": 2, "cdp": "9.3.1 (coordinates)", "irma": "4.2.2 (site characterisation)" } },
        "longitude": { "type": "number", "title": "Longitude (WGS84)", "minimum": -180, "maximum": 180, "x-mwp": { "tier": 1, "tier1_no": 2, "cdp": "9.3.1 (coordinates)" } },
        "primary_commodity": { "title": "Primary commodity", "enum": ["Cu", "Li", "Ni", "Co", "Zn", "Au", "Fe", "Mn", "graphite", "REE", "other"], "x-mwp": { "tier": 1, "tier1_no": 3 } },
        "mine_type": { "title": "Mine type", "enum": ["open_pit", "underground", "open_pit_and_underground", "brine", "in_situ_leach", "tailings_reprocessing"], "x-mwp": { "tier": 1, "tier1_no": 4 } },
        "processing_route": {
          "type": "array", "title": "Processing route(s)", "minItems": 1,
          "items": { "enum": ["flotation", "dense_media_separation", "heap_leach_sx_ew", "agitated_leach_sx_ew", "bioheap_leach", "hpal", "brine_evaporation", "direct_lithium_extraction", "gravity", "smelting_refining", "none_ore_shipped"] },
          "x-mwp": { "tier": 1, "tier1_no": 4 }
        },
        "lifecycle_stage": { "title": "Lifecycle stage", "enum": ["exploration", "construction", "operating", "care_and_maintenance", "closure"], "x-mwp": { "tier": 2 } },
        "basin": {
          "type": "object",
          "title": "Basin context (derived from coordinates - not a reporting burden)",
          "properties": {
            "name": { "type": "string", "title": "Basin / catchment name" },
            "hybas_l6_id": { "type": "string", "title": "HydroBASINS level-6 ID" },
            "bws_score": { "type": "number", "title": "Aqueduct 4.0 baseline water stress score (0-5)", "minimum": 0, "maximum": 5, "x-mwp": { "tier": "derived", "gri": "303-3-b / 303-5-b (areas with water stress)", "esrs": "E3-4 §28(b) (areas at water risk)", "cdp": "9.2.4", "icmm": "sites in water-stressed areas" } },
            "bws_category": { "title": "Aqueduct baseline water stress category", "enum": ["low", "low_medium", "medium_high", "high", "extremely_high", "arid_low_water_use"], "x-mwp": { "tier": "derived" } },
            "bws_source": { "type": "string", "title": "Stress data source & version" }
          }
        }
      }
    },
    "period": {
      "type": "object",
      "title": "Reporting period",
      "required": ["year"],
      "properties": {
        "year": { "type": "integer", "title": "Reporting year", "minimum": 2000, "maximum": 2100, "x-mwp": { "tier": 1, "tier1_no": 5 } },
        "start_date": { "type": "string", "title": "Start date (YYYY-MM-DD)", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "end_date": { "type": "string", "title": "End date (YYYY-MM-DD)", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      }
    },
    "production": {
      "type": "object",
      "title": "Production (denominators for normalised intensities)",
      "required": ["products"],
      "anyOf": [ { "required": ["ore_processed_t"] }, { "required": ["brine_processed_m3"] } ],
      "properties": {
        "ore_processed_t": { "type": "number", "title": "Ore processed (t, dry)", "minimum": 0, "x-mwp": { "tier": 1, "tier1_no": 6, "cdp": "9.12 (intensity denominator)" } },
        "brine_processed_m3": { "type": "number", "title": "Brine processed (m3) - brine operations", "minimum": 0, "x-mwp": { "tier": 1, "tier1_no": 6 } },
        "products": {
          "type": "array", "title": "Products & contained metal", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["commodity", "metal_content_t", "basis"],
            "properties": {
              "commodity": { "title": "Commodity", "enum": ["Cu", "Li", "Ni", "Co", "Zn", "Au", "Fe", "Mn", "graphite", "REE", "other"] },
              "product_form": { "type": "string", "title": "Product form (e.g. concentrate, cathode, Li2CO3, MHP)" },
              "product_t": { "type": "number", "title": "Product mass (t)", "minimum": 0 },
              "metal_content_t": { "type": "number", "title": "Contained metal / equivalent (t)", "minimum": 0, "x-mwp": { "tier": 1, "tier1_no": 7 } },
              "basis": { "title": "Metal basis", "enum": ["contained_metal", "LCE"], "description": "LCE = lithium carbonate equivalent (Li metal x 5.323)." },
              "allocation_share": { "type": "number", "title": "Water allocation share (0-1, economic allocation)", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "water": {
      "type": "object",
      "title": "Site water balance (ML)",
      "required": ["withdrawals", "discharges", "consumption", "reuse"],
      "properties": {
        "withdrawals": {
          "type": "array", "title": "Withdrawals (operational inputs) by source", "minItems": 1,
          "x-mwp": { "tier": 1, "tier1_no": 8, "gri": "303-3-a/c", "esrs": "E3-4 AR 32 (may disclose)", "cdp": "9.2.2, 9.2.7", "icmm": "operational water withdrawal by source", "waf": "Inputs", "irma": "4.2.5.1(b) volume extracted/pumped" },
          "items": {
            "type": "object",
            "required": ["source", "volume_ml", "dq"],
            "properties": {
              "source": { "title": "Source", "enum": ["surface_water", "groundwater", "seawater", "third_party"] },
              "subtype": { "title": "Sub-type", "enum": ["river_lake_abstraction", "precipitation_runoff", "bore_field", "mine_dewatering", "ore_entrainment", "brine", "seawater_direct", "desalinated_seawater", "municipal_supply", "other_operation", "treated_wastewater"], "description": "WAF 2.0 rolls precipitation & runoff into surface water and ore entrainment into groundwater; MWP keeps them visible as sub-types." },
              "quality": { "title": "Quality category (WAF)", "enum": ["cat1", "cat2", "cat3"], "description": "WAF Cat 1 high quality (minimal treatment) / Cat 2 medium / Cat 3 low (high TDS, metals, extreme pH). ICMM high = Cat 1; low = Cat 2+3 (MWP crosswalk)." },
              "freshwater_gri": { "type": "boolean", "title": "Freshwater per GRI 303 (TDS <= 1,000 mg/L)" },
              "volume_ml": { "type": "number", "title": "Volume (ML)", "minimum": 0 },
              "dq": { "title": "Data quality", "enum": ["measured", "calculated", "estimated"] }
            }
          }
        },
        "discharges": {
          "type": "array", "title": "Discharges (outputs returned) by destination",
          "x-mwp": { "tier": 1, "tier1_no": 9, "gri": "303-4-a/b", "esrs": "E3-4 AR 32 (may disclose)", "cdp": "9.2.2, 9.2.8", "icmm": "discharge by destination", "waf": "Outputs", "irma": "4.2.5.1(b) volume discharged" },
          "items": {
            "type": "object",
            "required": ["destination", "volume_ml", "dq"],
            "properties": {
              "destination": { "title": "Destination", "enum": ["surface_water", "groundwater", "seawater", "third_party"] },
              "quality": { "title": "Quality category (WAF)", "enum": ["cat1", "cat2", "cat3"] },
              "treated": { "type": "boolean", "title": "Treated before discharge" },
              "volume_ml": { "type": "number", "title": "Volume (ML)", "minimum": 0 },
              "dq": { "title": "Data quality", "enum": ["measured", "calculated", "estimated"] }
            }
          }
        },
        "consumption": {
          "type": "object",
          "title": "Consumption (not returned: evaporation, entrainment, other losses)",
          "required": ["total_ml", "total_dq"],
          "x-mwp": { "tier": 1, "tier1_no": 10, "gri": "303-5-a", "esrs": "E3-4 §28(a)", "cdp": "9.2.2", "icmm": "consumption (evaporation, entrainment, other)", "waf": "Other (consumption) output" },
          "properties": {
            "total_ml": { "type": "number", "title": "Total consumption (ML)", "minimum": 0 },
            "total_dq": { "title": "Data quality (total)", "enum": ["measured", "calculated", "estimated"] },
            "evaporation_ml": { "type": "number", "title": "Evaporation (ML)", "minimum": 0, "x-mwp": { "tier": 2 } },
            "evaporation_dq": { "title": "Data quality (evaporation)", "enum": ["measured", "calculated", "estimated"] },
            "entrainment_ml": { "type": "number", "title": "Entrainment in tailings & product (ML)", "minimum": 0, "x-mwp": { "tier": 2 } },
            "entrainment_dq": { "title": "Data quality (entrainment)", "enum": ["measured", "calculated", "estimated"] },
            "other_ml": { "type": "number", "title": "Other losses (ML)", "minimum": 0, "x-mwp": { "tier": 2 } },
            "other_dq": { "title": "Data quality (other)", "enum": ["measured", "calculated", "estimated"] }
          }
        },
        "storage": {
          "type": "object",
          "title": "Storage (ponds, TSF decant, pit water)",
          "x-mwp": { "tier": 2, "gri": "303-5-c", "esrs": "E3-4 §28(d)", "icmm": "change in storage (recommended)", "waf": "Change in storage" },
          "properties": {
            "opening_ml": { "type": "number", "title": "Opening storage (ML)", "minimum": 0 },
            "closing_ml": { "type": "number", "title": "Closing storage (ML)", "minimum": 0 },
            "dq": { "title": "Data quality", "enum": ["measured", "calculated", "estimated"] }
          }
        },
        "reuse": {
          "type": "object",
          "title": "Reuse & recycling",
          "required": ["reused_recycled_ml", "dq"],
          "x-mwp": { "tier": 1, "tier1_no": 11, "esrs": "E3-4 §28(c)", "icmm": "reuse/recycle (required)", "waf": "Reuse & recycling efficiency" },
          "properties": {
            "task_water_ml": { "type": "number", "title": "Total water to tasks (ML)", "minimum": 0, "x-mwp": { "tier": 2 } },
            "reused_recycled_ml": { "type": "number", "title": "Reused + recycled water (ML)", "minimum": 0 },
            "tsf_return_ml": { "type": "number", "title": "of which returned from TSF (ML)", "minimum": 0, "x-mwp": { "tier": 2 } },
            "dq": { "title": "Data quality", "enum": ["measured", "calculated", "estimated"] }
          }
        },
        "other_managed_water_ml": { "type": "number", "title": "Other managed water (ML, WAF OMW)", "minimum": 0, "x-mwp": { "tier": 2, "icmm": "other managed water withdrawal" } },
        "monthly": {
          "type": "array", "title": "Monthly profile (seasonality)",
          "x-mwp": { "tier": 2, "irma": "4.2.4 (monitoring)", "note": "Required in Tier 2 for sites in high/extremely-high stress basins" },
          "items": {
            "type": "object",
            "required": ["month", "withdrawal_ml", "consumption_ml"],
            "properties": {
              "month": { "type": "integer", "minimum": 1, "maximum": 12 },
              "withdrawal_ml": { "type": "number", "minimum": 0 },
              "consumption_ml": { "type": "number", "minimum": 0 },
              "discharge_ml": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "title": "Context indicators",
      "x-mwp": { "tier": 2, "esrs": "E3-4 §28(e)", "gri": "303-1 / 303-3-d", "irma": "4.2.1 (context & collaboration)" },
      "properties": {
        "competing_users": { "type": "array", "title": "Competing users in basin", "items": { "enum": ["agriculture", "municipal_drinking", "indigenous_communities", "ecosystems_wetlands", "other_mining", "industry", "hydropower", "tourism"] } },
        "seasonality": { "title": "Seasonality of supply", "enum": ["none", "moderate", "strong"] },
        "water_grievances": { "type": "integer", "title": "Water-related community grievances (count)", "minimum": 0 },
        "water_incidents": { "type": "integer", "title": "Water-related incidents / permit exceedances (count)", "minimum": 0, "x-mwp": { "gri": "303-4-d (non-compliance incidents)" } },
        "notes": { "type": "string", "title": "Context notes" }
      }
    },
    "assurance": {
      "type": "object",
      "title": "Methodology & assurance",
      "required": ["level"],
      "properties": {
        "level": { "title": "Assurance level", "enum": ["none", "internal_review", "limited", "reasonable"], "x-mwp": { "tier": 1, "tier1_no": 12 } },
        "provider": { "type": "string", "title": "Assurance provider" },
        "methodology": { "title": "Accounting methodology", "enum": ["ICMM_2021", "MCA_WAF_2_0", "GRI_303_2018", "company_specific"] }
      }
    },
    "sources": {
      "type": "array", "title": "Source documents",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "page": { "type": "string" },
          "extraction": { "enum": ["reported_directly", "manual_extraction", "automated_extraction_reviewed", "automated_extraction_unreviewed"] }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "tier": { "const": "tier2" } }, "required": ["tier"] },
      "then": {
        "required": ["context"],
        "properties": {
          "water": {
            "required": ["storage"],
            "properties": {
              "withdrawals": { "items": { "required": ["subtype", "quality"] } },
              "discharges": { "items": { "required": ["quality"] } },
              "consumption": { "required": ["evaporation_ml", "entrainment_ml", "other_ml"] },
              "reuse": { "required": ["task_water_ml"] }
            }
          }
        }
      }
    }
  ]
}
