{
  "name": "aquatrace",
  "version": "0.1.0",
  "private": true,
  "description": "Site-level mine water ledger: import, standardise to ICMM 2021, validate, and stress-test water data.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "verify-import": "tsx --tsconfig tsconfig.scripts.json scripts/verify-import.ts",
    "verify-template": "tsx --tsconfig tsconfig.scripts.json scripts/verify-template.ts",
    "build-corpus": "tsx --tsconfig tsconfig.scripts.json scripts/build-corpus.ts",
    "verify-corpus": "tsx --tsconfig tsconfig.scripts.json scripts/verify-corpus.ts",
    "make-submission-files": "tsx --tsconfig tsconfig.scripts.json scripts/make-submission-files.ts",
    "analyse-submission": "tsx --tsconfig tsconfig.scripts.json scripts/analyse-submission.ts",
    "verify": "npm run verify-import && npm run verify-template"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.3.3",
    "tsx": "^4",
    "typescript": "^5"
  }
}
